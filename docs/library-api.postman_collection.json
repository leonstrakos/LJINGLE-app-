{
  "info": {
    "name": "Personal Catalogue API",
    "description": "Zahtjevi za testiranje osobnog kataloga knjiga, igara, filmova/serija, tema, aktivnosti, povijesti, statistike, zapisa i uvoza metapodataka.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "bookId",
      "value": "71ca50e7-0f55-4e1e-a169-857f3fb94e55"
    },
    {
      "key": "activityId",
      "value": ""
    },
    {
      "key": "topicId",
      "value": ""
    },
    {
      "key": "entryId",
      "value": ""
    },
    {
      "key": "gameId",
      "value": ""
    },
    {
      "key": "mediaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Dohvati sve knjige",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "Dohvati stranicu knjiga",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books?page=0&size=10"
      }
    },
    {
      "name": "Dohvati jednu knjigu",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "Dodaj knjigu",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('bookId', body.bookId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Dina\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"978-0441172719\",\n  \"publishedYear\": 1965,\n  \"readingStatus\": \"IN_PROGRESS\",\n  \"progress\": 25,\n  \"enjoyment\": \"ENJOYED\",\n  \"favourite\": true,\n  \"startedOn\": \"2026-08-18\",\n  \"finishedOn\": null\n}"
        },
        "url": "{{baseUrl}}/books"
      }
    },
    {
      "name": "Ažuriraj knjigu",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Dina Mesija\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"978-0593098233\",\n  \"publishedYear\": 1969,\n  \"readingStatus\": \"COMPLETED\",\n  \"progress\": 100,\n  \"enjoyment\": \"ENJOYED\",\n  \"favourite\": true,\n  \"startedOn\": \"2026-08-01\",\n  \"finishedOn\": \"2026-08-18\"\n}"
        },
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "Dohvati timer čitanja",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/activities/books/{{bookId}}/reading"
      }
    },
    {
      "name": "Pokreni čitanje",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('activityId', body.activityId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/activities/books/{{bookId}}/reading/start"
      }
    },
    {
      "name": "Zaustavi čitanje",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/activities/books/{{bookId}}/reading/stop"
      }
    },
    {
      "name": "Dohvati aktivne timere",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/activities/active"
      }
    },
    {
      "name": "Dohvati nedavne pauzirane aktivnosti",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/activities/recent?limit=6"
      }
    },
    {
      "name": "Zaustavi aktivnost po identifikatoru",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/activities/{{activityId}}/stop"
      }
    },
    {
      "name": "Dohvati sesije aktivnosti",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/activities/{{activityId}}/sessions"
      }
    },
    {
      "name": "Pokreni aktivnost po identifikatoru",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/activities/{{activityId}}/start"
      }
    },
    {
      "name": "Dohvati teme",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/topics"
      }
    },
    {
      "name": "Dodaj temu",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('topicId', body.topicId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Šah\",\n  \"description\": \"Igranje i proučavanje šaha\"\n}"
        },
        "url": "{{baseUrl}}/topics"
      }
    },
    {
      "name": "Dohvati temu",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/topics/{{topicId}}"
      }
    },
    {
      "name": "Ažuriraj temu",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Šah i strategija\",\n  \"description\": \"Osobna tema\"\n}"
        },
        "url": "{{baseUrl}}/topics/{{topicId}}"
      }
    },
    {
      "name": "Dodaj aktivnost temi",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('activityId', body.activityId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"label\": \"Igrati šah\",\n  \"activityType\": \"PLAYING\"\n}"
        },
        "url": "{{baseUrl}}/topics/{{topicId}}/activities"
      }
    },
    {
      "name": "Dohvati aktivnosti teme",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/topics/{{topicId}}/activities"
      }
    },
    {
      "name": "Današnje vrijeme",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/stats/daily?date=2026-08-18&zone=Europe/Zagreb"
      }
    },
    {
      "name": "Povijest sesija",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/history/sessions?page=0&size=30&zone=Europe/Zagreb"
      }
    },
    {
      "name": "Dodaj zapis",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('entryId', body.entryId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ključni citat\",\n  \"content\": \"Strah ubija um.\",\n  \"type\": \"QUOTE\",\n  \"bookId\": \"{{bookId}}\",\n  \"topicId\": \"{{topicId}}\",\n  \"activityId\": \"{{activityId}}\"\n}"
        },
        "url": "{{baseUrl}}/entries"
      }
    },
    {
      "name": "Dohvati filtrirane zapise",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/entries?topicId={{topicId}}&type=QUOTE"
      }
    },
    {
      "name": "Dohvati zapis",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/entries/{{entryId}}"
      }
    },
    {
      "name": "Ažuriraj zapis",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Napredak\",\n  \"content\": \"Stigao sam do polovice.\",\n  \"type\": \"PROGRESS_UPDATE\",\n  \"bookId\": \"{{bookId}}\",\n  \"topicId\": null,\n  \"activityId\": null\n}"
        },
        "url": "{{baseUrl}}/entries/{{entryId}}"
      }
    },
    {
      "name": "Obriši zapis",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/entries/{{entryId}}"
      }
    },
    {
      "name": "Obriši temu",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/topics/{{topicId}}"
      }
    },
    {
      "name": "Obriši knjigu",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/books/{{bookId}}"
      }
    },
    {
      "name": "Dodaj igru",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('gameId', body.gameId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Disco Elysium\",\n  \"developer\": \"ZA/UM\",\n  \"platform\": \"PC\",\n  \"releaseYear\": 2019,\n  \"gameStatus\": \"PLAYING\",\n  \"progress\": 38,\n  \"enjoyment\": \"ENJOYED\",\n  \"favourite\": true,\n  \"startedOn\": \"2026-08-01\",\n  \"finishedOn\": null,\n  \"igdbId\": 26192,\n  \"coverUrl\": null\n}"
        },
        "url": "{{baseUrl}}/games"
      }
    },
    {
      "name": "Dohvati igre",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/games"
      }
    },
    {
      "name": "Pokreni igranje",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/games/{{gameId}}/timer/start"
      }
    },
    {
      "name": "Zaustavi igranje",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/games/{{gameId}}/timer/stop"
      }
    },
    {
      "name": "Online pretraga igara",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/games/metadata/search?query=Outer%20Wilds"
      }
    },
    {
      "name": "Dodaj film",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('mediaId', body.mediaId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mediaType\": \"MOVIE\",\n  \"tmdbId\": 438631,\n  \"title\": \"Dune\",\n  \"originalTitle\": \"Dune\",\n  \"overview\": null,\n  \"posterPath\": null,\n  \"backdropPath\": null,\n  \"releaseYear\": 2021,\n  \"watchStatus\": \"WATCHLIST\",\n  \"progress\": 0,\n  \"enjoyment\": null,\n  \"favourite\": false,\n  \"startedOn\": null,\n  \"completedOn\": null\n}"
        },
        "url": "{{baseUrl}}/media"
      }
    },
    {
      "name": "Dohvati filmove i serije",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/media"
      }
    },
    {
      "name": "Pokreni gledanje",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/media/{{mediaId}}/watching/start"
      }
    },
    {
      "name": "Zaustavi gledanje",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/media/{{mediaId}}/watching/stop"
      }
    },
    {
      "name": "Online pretraga filmova i serija",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/media/tmdb/search?query=Dune&mediaType=MOVIE&page=1"
      }
    },
    {
      "name": "Pretraži metapodatke knjiga",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/book-metadata/search?q=Dune&limit=20"
      }
    },
    {
      "name": "Dohvati knjigu po ISBN-u",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/book-metadata/isbn/9780441172719"
      }
    }
  ]
}
