--- a/src/storage/backup.ts	1970-01-01 01:00:00.000000000 +0100
+++ "b/src/storage/backup.ts"	2026-08-21 19:23:39.600678065 +0200
@@ -0,0 +1,28 @@
+import { getDatabase } from './database';
+
+const tables = ['books','topics','media_items','activities','games','time_sessions','entries'] as const;
+type Table = typeof tables[number];
+type Backup = { version: 1; exportedAt: string; tables: Record<Table, Record<string, unknown>[]> };
+
+export async function exportLocalData() {
+  const database = await getDatabase();
+  const data = {} as Backup['tables'];
+  for (const table of tables) data[table] = await database.getAllAsync<Record<string, unknown>>(`SELECT * FROM ${table}`);
+  return JSON.stringify({ version: 1, exportedAt: new Date().toISOString(), tables: data } satisfies Backup, null, 2);
+}
+
+export async function importLocalData(text: string) {
+  let backup: Backup;
+  try { backup = JSON.parse(text) as Backup; } catch { throw new Error('JSON nije valjan.'); }
+  if (backup.version !== 1 || !backup.tables || !tables.every((table) => Array.isArray(backup.tables[table]))) throw new Error('Ovo nije backup iz Life Catalogue aplikacije.');
+  const database = await getDatabase();
+  await database.withExclusiveTransactionAsync(async () => {
+    await database.execAsync('PRAGMA foreign_keys = OFF;');
+    for (const table of [...tables].reverse()) await database.runAsync(`DELETE FROM ${table}`);
+    for (const table of tables) for (const row of backup.tables[table]) {
+      const columns = Object.keys(row); if (!columns.length) continue;
+      await database.runAsync(`INSERT INTO ${table} (${columns.join(',')}) VALUES (${columns.map(() => '?').join(',')})`, ...columns.map((column) => (row[column] ?? null) as string | number | null));
+    }
+    await database.execAsync('PRAGMA foreign_keys = ON;');
+  });
+}
