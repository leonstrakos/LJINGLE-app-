+import { useState } from 'react';
+import { Alert, Pressable, StyleSheet, Text, TextInput, View } from 'react-native';
+import type { NativeStackScreenProps } from '@react-navigation/native-stack';
+import { SafeAreaView } from 'react-native-safe-area-context';
+
+import { activityApi } from '../services/activityApi';
+import { colors } from '../theme/colors';
+import type { ActivityType } from '../types/activity';
+import type { RootStackParamList } from '../types/navigation';
+
+type Props = NativeStackScreenProps<RootStackParamList, 'QuickAdd'>;
+const types: Array<[ActivityType, string]> = [
+  ['WORK', 'Rad'], ['STUDYING', 'Učenje'], ['RESEARCH', 'Istraživanje'],
+  ['EXERCISE', 'Kretanje'], ['CUSTOM', 'Ostalo'],
+];
+
+export function QuickAddScreen({ navigation }: Props) {
+  const [label, setLabel] = useState('');
+  const [activityType, setActivityType] = useState<ActivityType>('WORK');
+  const [saving, setSaving] = useState(false);
+  const start = async () => {
+    if (!label.trim() || saving) return;
+    setSaving(true);
+    try {
+      const activity = await activityApi.create({ label, activityType });
+      await activityApi.start(activity.activityId!);
+      navigation.replace('ActivityDetails', { activityId: activity.activityId! });
+    } catch (error) {
+      Alert.alert('Nije spremljeno', error instanceof Error ? error.message : 'Pokušaj ponovno.');
+      setSaving(false);
+    }
+  };
+  return <SafeAreaView style={styles.safe} edges={['left', 'right', 'bottom']}><View style={styles.content}>
+    <Text style={styles.kicker}>BRZI POČETAK</Text><Text style={styles.title}>Što radiš?</Text>
+    <Text style={styles.copy}>Samo napiši naziv — vrijeme kreće odmah i ostaje spremljeno na telefonu.</Text>
+    <TextInput autoFocus value={label} onChangeText={setLabel} placeholder="npr. Učim anatomiju" placeholderTextColor={colors.textMuted} style={styles.input} returnKeyType="done" onSubmitEditing={() => void start()} />
+    <Text style={styles.label}>Vrsta</Text><View style={styles.types}>{types.map(([value, name]) => <Pressable key={value} onPress={() => setActivityType(value)} style={[styles.type, activityType === value && styles.typeSelected]}><Text style={[styles.typeText, activityType === value && styles.typeTextSelected]}>{name}</Text></Pressable>)}</View>
+    <Pressable disabled={!label.trim() || saving} onPress={() => void start()} style={[styles.start, (!label.trim() || saving) && styles.disabled]}><Text style={styles.startText}>{saving ? 'Spremam…' : 'Započni sada'}</Text></Pressable>
+  </View></SafeAreaView>;
+}
