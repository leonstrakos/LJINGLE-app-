{
  "expo": {
    "name": "LJingle",
    "slug": "moja-knjiznica",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hr.leon.mojaknjiznica",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "hr.leon.mojaknjiznica",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "icon": "./assets/logo.png",
    "plugins": [
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "onnxruntime-react-native",
      "expo-secure-store",
      "react-native-pdf-jsi"
    ],
    "owner": "noviaccleki",
    "extra": {
      "eas": {
        "projectId": "6045e9c9-8044-47dc-97fb-fc2a9d8bb205"
      }
    }
  }
}
