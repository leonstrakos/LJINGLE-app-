+        if (selectionExecutor == null || selectionExecutor.isShutdown())
+            selectionExecutor = Executors.newSingleThreadExecutor();
+        selectionExecutor.execute(() -> {
+            if (generation != selectionGeneration) return;
+            ParcelFileDescriptor descriptor = null;
+            PdfDocument document = null;
+            PdfPage pdfPage = null;
+            PdfTextPage textPage = null;
+            try {
+                descriptor = openSelectionDescriptor(source);
+                if (descriptor == null) throw new IOException("PDF nije dostupan.");
+                document = new PdfiumCore().newDocument(descriptor, documentPassword);
+                pdfPage = document.openPage(startTarget.pageIndex);
+                if (pdfPage == null) throw new IOException("Stranica nije dostupna.");
+                float width = pdfPage.getPageWidthPoint(), height = pdfPage.getPageHeightPoint();
+                if (width <= 0 || height <= 0) throw new IOException("Neispravna veličina stranice.");
+                mainHandler.post(() -> {
+                    if (generation == selectionGeneration && java.util.Objects.equals(source, path)) {
+                        SearchRegistry.registerPageSizePoints(documentId, startTarget.pageIndex, width, height);
+                        invalidate();
+                    }
+                });
+                textPage = pdfPage.openTextPage();
+                int count = textPage == null ? 0 : textPage.textPageCountChars();
+                if (count <= 0) {
+                    dispatchSelectionEvent("textSelectionUnavailable|" + (startTarget.pageIndex + 1), generation);
+                    return;
+                }
+                int first = textPage.textPageGetCharIndexAtPos(startTarget.x * width, (1 - startTarget.y) * height, 12, 12);
+                int last = textPage.textPageGetCharIndexAtPos(endTarget.x * width, (1 - endTarget.y) * height, 12, 12);
+                if (first < 0 || first >= count) {
+                    dispatchSelectionEvent("textSelectionError|Drži izravno na slovima teksta.", generation);
+                    return;
+                }
+                if (last < 0 || last >= count) last = first;
+                int start = Math.min(first, last), end = Math.max(first, last) + 1;
+                // Use PDF character indices for both text and boxes (not Java UTF-16 offsets).
+                while (start > 0) {
+                    String previous = textPage.textPageGetText(start - 1, 1);
+                    if (previous == null || previous.isEmpty() || wordBoundary(previous.charAt(0))) break;
+                    start--;
+                }
+                while (end < count) {
+                    String next = textPage.textPageGetText(end, 1);
+                    if (next == null || next.isEmpty() || wordBoundary(next.charAt(0))) break;
+                    end++;
+                }
+                String text = textPage.textPageGetText(start, end - start);
+                if (text == null || text.trim().isEmpty()) {
+                    dispatchSelectionEvent("textSelectionError|Drži izravno na slovima teksta.", generation);
+                    return;
+                }
+                java.util.ArrayList<java.util.Map<String, Object>> rects = new java.util.ArrayList<>();
+                int rectCount = textPage.textPageCountRects(start, end - start);
+                for (int i = 0; i < rectCount; i++) {
+                    RectF rect = textPage.textPageGetRect(i);
+                    if (rect == null) continue;
+                    java.util.Map<String, Object> item = new java.util.LinkedHashMap<>();
+                    item.put("page", startTarget.pageIndex + 1);
+                    item.put("rect", Math.min(rect.left, rect.right) + "," + Math.max(rect.top, rect.bottom) + "," + Math.max(rect.left, rect.right) + "," + Math.min(rect.top, rect.bottom));
+                    rects.add(item);
+                }
+                if (rects.isEmpty()) {
+                    dispatchSelectionEvent("textSelectionError|PDF vraća tekst bez koordinata za označavanje.", generation);
+                    return;
+                }
+                java.util.Map<String, Object> payload = new java.util.LinkedHashMap<>();
+                payload.put("page", startTarget.pageIndex + 1);
